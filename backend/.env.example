# ===== 复制为 .env 后填写 =====

# JWT 密钥（随便一串长随机字符串）
SECRET_KEY=change-me-to-a-random-long-string

# aihubmix 中转 API（https://aihubmix.com 注册获取）
AIHUBMIX_API_KEY=
# 模型名，可随时在 aihubmix 后台切换（GLM 便宜款）
AI_MODEL=glm-4.9-flash
# 主域名 aihubmix.com 在国内部分网络 DNS 被污染连不上时，改用官方备用域名
# AI_BASE_URL=https://api.inferera.com/v1

# 服务端口
PORT=8000
